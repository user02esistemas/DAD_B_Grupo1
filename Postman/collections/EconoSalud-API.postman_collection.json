              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ],
              "query": [
                {
                  "key": "termino",
                  "value": "para"
                },
                {
                  "key": "limite",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
